#!/usr/bin/env python3
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from torchvision import transforms, models
import numpy as np
import pandas as pd
from PIL import Image
from pathlib import Path
import json
import time
from torch.nn.utils import clip_grad_norm_

# Constants
BATCH_SIZE = 32
EPOCHS = 3
## need to play with this, think that 20 epics is good, prehaps 
LEARNING_RATE = 0.001
IMAGE_SIZE = (256, 256)

class SyntheticTextDataset(Dataset):
    def __init__(self, image_dir, metadata_file, label_file, num_classes, transform=None):
        self.image_dir = image_dir
        self.metadata = pd.read_csv(metadata_file)
        self.labels = np.load(label_file, allow_pickle=True)
        self.transform = transform
        self.num_classes = num_classes
        
        # Print debug information about labels
        print(f"Label shape: {self.labels.shape}")
        print(f"First label example: {self.labels[0]}")
        
        # Validate labels
        try:
            # Assuming labels are one-hot encoded arrays
            if isinstance(self.labels[0][0], np.ndarray):
                max_label = max(
                    np.max([np.argmax(label[0]) for label in self.labels]),
                    np.max([np.argmax(label[1]) for label in self.labels])
                )
            else:
                max_label = max(
                    np.max([label[0] for label in self.labels]),
                    np.max([label[1] for label in self.labels])
                )
                
            if max_label >= num_classes:
                raise ValueError(f"Found label index {max_label} which is >= number of classes {num_classes}. "
                               f"Please check your encoded_labels.npy file and words.txt file.")
        except Exception as e:
            print(f"Error during label validation: {str(e)}")
            print(f"Label type: {type(self.labels[0][0])}")
            raise

    def __len__(self):
        return len(self.metadata)

    def __getitem__(self, idx):
        img_name = Path(self.image_dir) / self.metadata.iloc[idx]["filename"]
        image = Image.open(img_name).convert("RGB")
        label = self.labels[idx]
        
        # Convert labels to one-hot encoding
        word1_label = torch.zeros(self.num_classes)
        word2_label = torch.zeros(self.num_classes)
        
        try:
            # Handle different label formats
            if isinstance(label[0], np.ndarray):
                # If labels are already one-hot encoded
                word1_label = torch.from_numpy(label[0].astype(np.float32))
                word2_label = torch.from_numpy(label[1].astype(np.float32))
            else:
                # If labels are indices
                word1_idx = int(label[0])
                word2_idx = int(label[1])
                word1_label[word1_idx] = 1
                word2_label[word2_idx] = 1
        except Exception as e:
            print(f"Error processing label at index {idx}: {str(e)}")
            print(f"Label value: {label}")
            raise
        
        if self.transform:
            image = self.transform(image)
        return image, (word1_label, word2_label)

class SyntheticTextModel(nn.Module):
    def __init__(self, num_classes):
        super().__init__()
        self.backbone = models.resnet18(pretrained=True)
        self.backbone.fc = nn.Identity()
        
        self.word1_head = nn.Sequential(
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(256, num_classes)
        )
        self.word2_head = nn.Sequential(
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(256, num_classes)
        )

    def forward(self, x):
        features = self.backbone(x)
        word1_pred = self.word1_head(features)
        word2_pred = self.word2_head(features)
        return word1_pred, word2_pred

def train_model(data_dir, dict_file):
    # Setup logging
    log_file = open(Path(data_dir) / "training_log.txt", "a")
    
    # Get number of classes from dictionary file
    with open(dict_file, 'r') as f:
        vocab = [line.strip() for line in f if line.strip()]
    num_classes = len(vocab)
    print(f"Number of classes (vocabulary size): {num_classes}")
    
    # Prepare data
    transform = transforms.Compose([
        transforms.Resize((256, 256)),
        transforms.ToTensor()
    ])
    
    try:
        # Create the data loader with num_classes parameter
        train_dataset = SyntheticTextDataset(
            str(Path(data_dir) / "train" / "images"),
            str(Path(data_dir) / "train" / "train_metadata.csv"),
            str(Path(data_dir) / "encoded_labels.npy"),
            num_classes,
            transform
        )
        train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True)
        
        # Initialize model and training components
        device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        print(f"Using device: {device}")
        model = SyntheticTextModel(num_classes).to(device)
        optimizer = optim.Adam(model.parameters(), lr=LEARNING_RATE)
        criterion = nn.CrossEntropyLoss()
        
        # Training loop
        for epoch in range(EPOCHS):
            start_time = time.time()
            model.train()
            total_loss = 0
            
            # Training epoch
            for batch_idx, (images, (word1_labels, word2_labels)) in enumerate(train_loader):
                images = images.to(device)
                word1_labels = word1_labels.to(device)
                word2_labels = word2_labels.to(device)
                
                optimizer.zero_grad()
                word1_pred, word2_pred = model(images)
                
                # Using argmax since we converted to one-hot in dataset
                loss = criterion(word1_pred, word1_labels.argmax(dim=1)) + \
                       criterion(word2_pred, word2_labels.argmax(dim=1))
                       
                loss.backward()
                clip_grad_norm_(model.parameters(), max_norm=1.0)
                optimizer.step()
                total_loss += loss.item()
                
                if batch_idx % 10 == 0:
                    print(f"Epoch {epoch+1}/{EPOCHS}, Batch {batch_idx}/{len(train_loader)}, "
                          f"Loss: {loss.item():.4f}")
            
            # Log epoch results
            epoch_time = time.time() - start_time
            avg_loss = total_loss / len(train_loader)
            print(f"Epoch {epoch+1}/{EPOCHS}, Average Loss: {avg_loss:.4f}, Time: {epoch_time:.2f}s")
            log_file.write(f"Epoch {epoch+1}, Loss: {avg_loss:.4f}, Time: {epoch_time:.2f}s\n")
            
        # Save model
        torch.save({
            'epoch': EPOCHS,
            'model_state_dict': model.state_dict(),
            'optimizer_state_dict': optimizer.state_dict(),
            'num_classes': num_classes,
        }, Path(data_dir) / "trained_model.pth")
        print("Model saved successfully!")
        
    except Exception as e:
        print(f"Error during training: {str(e)}")
        log_file.write(f"Error during training: {str(e)}\n")
        raise
    finally:
        log_file.close()

if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser(description="Train model on synthetic text images")
    parser.add_argument("--data_dir", type=str, default="./dataset", help="Data directory")
    parser.add_argument("--dict_file", type=str, default="words.txt", help="Dictionary file path")
    args = parser.parse_args()
    
    train_model(args.data_dir, args.dict_file)