#!/usr/bin/env python3
import torch
from pathlib import Path
import sys
sys.path.append('/path/to/directory/containing/train_model')
from train_model import SyntheticTextModel, SyntheticTextDataset
from torchvision import transforms
from torch.utils.data import DataLoader

def test_model(model_path, test_data_dir, dict_file):
    # Setup
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    num_classes = len(open(dict_file).readlines())
    
    # Load model
    model = SyntheticTextModel(num_classes).to(device)
    model.load_state_dict(torch.load(model_path))
    model.eval()
    
    # Prepare test data
    transform = transforms.Compose([
        transforms.Resize((256, 256)),
        transforms.ToTensor()
    ])
    
    test_dataset = SyntheticTextDataset(
        str(Path(test_data_dir) / "images"),
        str(Path(test_data_dir) / "test_metadata.csv"),
        str(Path(test_data_dir) / "encoded_labels.npy"),
        transform
    )
    test_loader = DataLoader(test_dataset, batch_size=32, shuffle=False)
    
    # Test the model
    correct_word1 = 0
    correct_word2 = 0
    total = 0
    
    with torch.no_grad():
        for images, (word1_labels, word2_labels) in test_loader:
            images = images.to(device)
            word1_labels = word1_labels.to(device)
            word2_labels = word2_labels.to(device)
            
            word1_pred, word2_pred = model(images)
            _, predicted_word1 = torch.max(word1_pred, 1)
            _, predicted_word2 = torch.max(word2_pred, 1)
            
            total += word1_labels.size(0)
            correct_word1 += (predicted_word1 == word1_labels.argmax(dim=1)).sum().item()
            correct_word2 += (predicted_word2 == word2_labels.argmax(dim=1)).sum().item()
    
    # Calculate and print results
    word1_accuracy = 100 * correct_word1 / total
    word2_accuracy = 100 * correct_word2 / total
    print(f"Test Accuracy: Word1: {word1_accuracy:.2f}%, Word2: {word2_accuracy:.2f}%")
    
    # Save results
    with open(Path(test_data_dir) / "test_results.txt", "w") as f:
        f.write(f"Test Accuracy:\nWord1: {word1_accuracy:.2f}%\nWord2: {word2_accuracy:.2f}%")

if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser(description="Test trained model")
    parser.add_argument("--model_path", type=str, required=True, help="Path to trained model")
    parser.add_argument("--test_data_dir", type=str, default="./dataset/test", help="Test data directory")
    parser.add_argument("--dict_file", type=str, default="words.txt", help="Dictionary file path")
    args = parser.parse_args()
    
    test_model(args.model_path, args.test_data_dir, args.dict_file)